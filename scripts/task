#!/bin/sh
# The seam between this project and everything that automates it.
#
# CI, the git hooks and scripts/agent know only the verbs below. Nothing outside
# this file knows Sprig is written in Rust, so CI and a local hook cannot drift
# apart: they run the same line.
set -eu

cd "$(dirname "$0")/.."

step() {
  printf '\n\033[1;34m▸ %s\033[0m\n' "$1"
}

usage() {
  cat <<'USAGE'
usage: scripts/task <target>

  fmt        format in place
  fmt:check  verify formatting; non-zero on drift
  lint       clippy with warnings denied, the core purity guard, and no packages in git
  test       the full test suite
  build      compile everything, including the tests
  install    cargo install the CLI into target/install, as a stranger would, and run it
  check      fmt:check, lint, test, build, and backlog when cairn is installed
  backlog    cairn check --strict, and ROADMAP.md is up to date (needs cairn)
  wasm       build sprig-core for the browser, into site/src/generated/sprig.wasm
  site       build the website, check tokens, contrast, links and accessibility (needs node, chrome)
  editors    test the TextMate and tree-sitter grammars and the VS Code extension (needs node, a display)
  perf       time parse, resolve and check against the committed baseline, in release builds
  mcp        a scripted session with sprig mcp through the official MCP client (needs node)
  fuzz       fuzz the parser and the edit API, FUZZ_SECONDS each (default 60; needs nightly and cargo-fuzz)
  audit      every lockfile against the RustSec and npm advisory databases (needs network)
USAGE
}

# sprig-core promises the same answer on every machine and every day, which it
# can only keep if it never reads the filesystem, the environment or the clock.
# A grep is crude, and that is the point: it is impossible to argue with.
purity() {
  if grep -rnE 'std::(fs|env|net|process)|SystemTime|Instant::now' crates/sprig-core/src; then
    printf '\nlint: sprig-core must not touch the filesystem, environment, network or clock.\n' >&2
    printf '      Take the value as a parameter; the CLI supplies it.\n' >&2
    exit 1
  fi
  # Every answer depends on the date only through --today, so the system date
  # is read in one place: the CLI's argument parser.
  if grep -rnE 'SystemTime|Instant::now|Zoned::now|Timestamp::now|chrono::|Local::' crates/*/src \
    | grep -v '^crates/sprig-cli/src/args.rs:'; then
    printf '\nlint: only crates/sprig-cli/src/args.rs may read the clock; take --today instead.\n' >&2
    exit 1
  fi
}

# Only source belongs in the tree. A package or an archive is a build output or
# a download, and once committed it stays in every clone forever; two reached
# the root unnoticed once (cairn 0151). So is anything over a mebibyte: the
# largest file written by hand is a fraction of that.
tracked() {
  bad=$(
    # awk, not grep, which fails when nothing matches and so stops `set -e`.
    git ls-files | awk 'tolower($0) ~ /\.(tar|tgz|zip|7z|gz|xz|bz2|whl|egg|crate|vsix|jar|exe|dll|so|dylib|deb|rpm|dmg|msi)$/'
    # Sizes from the index, which is what a commit would carry.
    git ls-files -s | awk -F '\t' '{ split($1, f, " "); print f[2], $2 }' \
      | git cat-file --batch-check='%(objectsize) %(rest)' \
      | awk '$1 > 1048576 { sub(/^[0-9]+ /, ""); print }'
  )
  if [ -n "$bad" ]; then
    printf '%s\n' "$bad" | sort -u
    printf '\nlint: these are packages, archives or files over 1 MiB, which do not belong in git.\n' >&2
    exit 1
  fi
}

case "${1:-}" in
  fmt)
    cargo fmt --all
    ;;
  fmt:check)
    cargo fmt --all -- --check
    ;;
  lint)
    purity
    tracked
    cargo clippy --all-targets --all-features -- -D warnings
    # The core's documentation is part of its API: complete, and with links
    # that resolve (docs/stability.md).
    RUSTDOCFLAGS="-D warnings" cargo doc --no-deps -p sprig-core
    ;;
  test)
    cargo test --all-targets
    # --all-targets leaves out doc examples, which are tests too.
    cargo test --doc --workspace
    # The workflow scripts are code too, and a broken one strands whoever
    # relies on it mid-task.
    for t in tests/scripts/*.sh; do
      sh "$t"
    done
    ;;
  build)
    cargo build --all-targets
    ;;
  install)
    # What the README tells a stranger to run, from this checkout, into a
    # directory of its own so nothing on the machine is touched.
    cargo install --locked --path crates/sprig-cli --root target/install
    target/install/bin/sprig --version
    ;;
  wasm)
    # The site has no parser of its own: it runs this one (cairn 0109).
    cargo build --locked -p sprig-wasm --target wasm32-unknown-unknown --profile wasm
    mkdir -p site/src/generated
    cp target/wasm32-unknown-unknown/wasm/sprig_wasm.wasm site/src/generated/sprig.wasm
    ;;
  site)
    "$0" wasm
    # The command reference page is the binary's own --help.
    cargo build --locked -p sprig-cli
    command -v npm >/dev/null 2>&1 || {
      printf 'scripts/task: npm is not installed; the site needs Node %s\n' "$(cat site/.node-version)" >&2
      exit 1
    }
    npm --prefix site ci --no-audit --no-fund
    npm --prefix site run build
    # axe in both themes; GitHub's runners ship Chrome, locally set CHROME_PATH if needed
    npm --prefix site run a11y
    ;;
  editors)
    # The TextMate grammar's snapshots, the tree-sitter grammar's corpus and
    # highlight snapshot (its agreement with the core runs under cargo test),
    # and the VS Code extension in a real VS Code, which needs a display: CI
    # runs this under xvfb-run. TREE_SITTER names a tree-sitter CLI to use
    # instead of the npm one, whose install downloads from GitHub.
    command -v npm >/dev/null 2>&1 || {
      printf 'scripts/task: npm is not installed; the editors need Node\n' >&2
      exit 1
    }
    npm --prefix editors ci --no-audit --no-fund ${TREE_SITTER:+--ignore-scripts}
    npm --prefix editors run test:textmate
    ts=${TREE_SITTER:-$PWD/editors/node_modules/.bin/tree-sitter}
    (
      cd editors/tree-sitter-sprig
      # ABI 14 loads in Neovim 0.9 and every newer tree-sitter host.
      TREE_SITTER_DIR="$PWD/test/config" "$ts" generate --abi 14
      # The generated parser is committed, so it must be what grammar.js says.
      git diff --exit-code -- src || {
        printf '\nscripts/task: src/ is stale; run tree-sitter generate in editors/tree-sitter-sprig and commit it\n' >&2
        exit 1
      }
      TREE_SITTER_DIR="$PWD/test/config" "$ts" test
      TREE_SITTER="$ts" test/highlight.sh
      # The Neovim section of the editor guide, followed on a clean config.
      if command -v nvim >/dev/null 2>&1; then
        so=$(mktemp -d)/sprig.so
        TREE_SITTER_DIR="$PWD/test/config" "$ts" build -o "$so"
        cargo build --locked -p sprig-cli
        work=$(mktemp -d)
        cp ../../examples/bakery/*.sprig "$work"
        nvim --headless --clean -u NONE -l ../neovim/test.lua "$(cd ../.. && pwd)/target/debug/sprig" "$so" "$work"
      else
        printf 'scripts/task: nvim is not installed; the Neovim guide was not followed\n' >&2
      fi
    )
    cargo build --locked -p sprig-cli
    npm --prefix editors/vscode ci --no-audit --no-fund
    npm --prefix editors/vscode test
    ;;
  mcp)
    # The unit tests drive the server with a client of this repository's own;
    # this drives it with the one agents' tools are built on.
    command -v npm >/dev/null 2>&1 || {
      printf 'scripts/task: npm is not installed; the MCP session needs Node\n' >&2
      exit 1
    }
    cargo build --locked -p sprig-cli
    npm --prefix tests/mcp ci --no-audit --no-fund
    node tests/mcp/session.mjs target/debug/sprig
    ;;
  fuzz)
    # Seeded with every file the suite and the examples hold, so the fuzzer
    # starts from plans rather than from nothing. A crash lands in
    # crates/sprig-core/fuzz/artifacts/ and becomes a test (cairn 0080).
    seconds=${FUZZ_SECONDS:-60}
    rustup toolchain list | grep -q '^nightly' || rustup toolchain install nightly --profile minimal
    command -v cargo-fuzz >/dev/null 2>&1 || cargo install --locked cargo-fuzz
    cd crates/sprig-core/fuzz
    for target in parse edits; do
      mkdir -p "corpus/$target"
      find ../../../tests/conformance ../../../examples -name '*.sprig' | {
        n=0
        while IFS= read -r f; do
          n=$((n + 1))
          cp "$f" "corpus/$target/seed-$n"
        done
      }
      cargo +nightly fuzz run "$target" "corpus/$target" -- -max_total_time="$seconds"
    done
    ;;
  audit)
    # Every lockfile the repository commits, so nothing it builds or tests
    # with carries a known advisory: the workspace, the fuzzer's own
    # workspace, the site, the editors and the MCP client test.
    command -v cargo-audit >/dev/null 2>&1 || cargo install --locked cargo-audit
    cargo audit --deny warnings --file Cargo.lock
    cargo audit --deny warnings --file crates/sprig-core/fuzz/Cargo.lock
    for dir in site editors editors/vscode tests/mcp; do
      printf '%s: ' "$dir"
      npm --prefix "$dir" audit --audit-level=low
    done
    ;;
  perf)
    # The baseline gate and the language server's 50 ms keystroke criterion,
    # both in release builds; see crates/sprig-core/benches/README.md.
    cargo bench --locked -p sprig-core --bench workspace
    cargo test --locked --release -p sprig-lsp --test lsp rechecking_a_large_workspace_after_a_keystroke_is_quick -- --nocapture
    ;;
  backlog)
    command -v cairn >/dev/null 2>&1 || {
      printf 'scripts/task: cairn is not installed; https://oddurs.github.io/cairn\n' >&2
      exit 1
    }
    cairn check --strict --render
    ;;
  check)
    step 'format'
    "$0" fmt:check
    step 'lint'
    "$0" lint
    step 'test'
    "$0" test
    step 'build'
    "$0" build
    # CI runs the backlog as a job of its own, so a machine without cairn is
    # told rather than failed; the pull request will still be held to it.
    step 'backlog'
    if command -v cairn >/dev/null 2>&1; then
      "$0" backlog
    else
      printf 'cairn not installed: backlog not checked here (CI checks it)\n'
    fi
    printf '\n\033[1;32m✓ green\033[0m\n'
    ;;
  -h | --help | help)
    usage
    ;;
  *)
    printf 'scripts/task: unknown target %s\n\n' "${1:-<none>}" >&2
    usage >&2
    exit 2
    ;;
esac
