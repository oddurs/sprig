{
  "name": "chea-editors",
  "private": true,
  "description": "Editor grammars for Chea, and their tests",
  "scripts": {
    "test:textmate": "vscode-tmgrammar-snap --grammar chea.tmLanguage.json --scope source.chea tests/textmate/*.chea",
    "update:textmate": "vscode-tmgrammar-snap -u --grammar chea.tmLanguage.json --scope source.chea tests/textmate/*.chea"
  },
  "devDependencies": {
    "vscode-tmgrammar-test": "0.1.3",
    "tree-sitter-cli": "0.27.1"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
