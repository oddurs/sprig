{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Chea",
  "scopeName": "source.chea",
  "fileTypes": [
    "chea"
  ],
  "patterns": [
    {
      "include": "#title"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#escaped-note"
    },
    {
      "include": "#answer"
    },
    {
      "include": "#item"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.chea",
      "match": "^\\s*//.*$"
    },
    "escaped-note": {
      "match": "^(\\s*)(\\\\)(.*)$",
      "captures": {
        "2": {
          "name": "constant.character.escape.chea"
        }
      }
    },
    "answer": {
      "begin": "^(\\s*)(=)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "keyword.mark.answer.chea"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#tokens"
        }
      ],
      "contentName": "markup.italic.answer.chea"
    },
    "item": {
      "patterns": [
        {
          "include": "#mark-todo"
        },
        {
          "include": "#mark-doing"
        },
        {
          "include": "#mark-done"
        },
        {
          "include": "#mark-dropped"
        },
        {
          "include": "#mark-later"
        },
        {
          "include": "#mark-ask"
        },
        {
          "include": "#mark-group"
        },
        {
          "include": "#mark-graft"
        }
      ]
    },
    "tokens": {
      "patterns": [
        {
          "name": "variable.other.person.chea",
          "match": "(?<=^|\\s)@[\\w.\\-]+(?=\\s|$)"
        },
        {
          "name": "entity.name.tag.chea",
          "match": "(?<=^|\\s)#[\\w\\-]+(?=\\s|$)"
        },
        {
          "name": "entity.name.label.anchor.chea",
          "match": "(?<=^|\\s)\\^[\\w\\-]+(?=\\s|$)"
        },
        {
          "name": "keyword.other.priority.chea",
          "match": "(?<=^|\\s)!{1,3}(?=\\s|$)"
        },
        {
          "match": "(?<=^|\\s)(\\p{L}[\\w\\-]*)(:)(\"[^\"]*\"|(?!//)\\S+)",
          "captures": {
            "1": {
              "name": "support.type.property-name.chea"
            },
            "2": {
              "name": "punctuation.separator.key-value.chea"
            },
            "3": {
              "name": "string.unquoted.value.chea",
              "patterns": [
                {
                  "include": "#link"
                }
              ]
            }
          }
        },
        {
          "include": "#link"
        }
      ]
    },
    "link": {
      "name": "markup.underline.link.chea",
      "match": "\\[\\[[^\\]\\s]+\\]\\]"
    },
    "mark-todo": {
      "begin": "^(\\s*)(-)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "keyword.mark.todo.chea"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#tokens"
        }
      ]
    },
    "mark-doing": {
      "begin": "^(\\s*)(~)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "keyword.mark.doing.chea"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#tokens"
        }
      ]
    },
    "mark-later": {
      "begin": "^(\\s*)(>)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "keyword.mark.later.chea"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#tokens"
        }
      ]
    },
    "mark-done": {
      "begin": "^(\\s*)(x)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "keyword.mark.done.chea"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#tokens"
        }
      ],
      "contentName": "markup.done.chea"
    },
    "mark-dropped": {
      "begin": "^(\\s*)(/)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "keyword.mark.dropped.chea"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#tokens"
        }
      ],
      "contentName": "markup.strikethrough.chea"
    },
    "mark-ask": {
      "begin": "^(\\s*)(\\?)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "keyword.mark.ask.chea"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#tokens"
        }
      ]
    },
    "mark-group": {
      "begin": "^(\\s*)(#)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "keyword.mark.group.chea"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#tokens"
        }
      ],
      "contentName": "markup.heading.group.chea"
    },
    "mark-graft": {
      "begin": "^(\\s*)(\\+)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "keyword.mark.graft.chea"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#tokens"
        }
      ]
    },
    "title": {
      "comment": "The first line, when it is not indented, a comment or an item (§1.2). TextMate sees one line at a time, so a title after blank lines is not found.",
      "begin": "\\A(?!\\s|//|[-~x/>?#+=](?:\\s|$))(\\\\)?",
      "beginCaptures": {
        "1": {
          "name": "constant.character.escape.chea"
        }
      },
      "end": "$",
      "contentName": "markup.heading.title.chea",
      "patterns": [
        {
          "include": "#tokens"
        }
      ]
    }
  }
}
