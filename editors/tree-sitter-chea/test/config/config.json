{
  "parser-directories": [
    ".."
  ],
  "theme": {
    "comment": 8,
    "keyword": 5,
    "markup.heading": {
      "bold": true
    },
    "markup.link": {
      "underline": true
    },
    "markup.strikethrough": {
      "italic": true
    },
    "markup.list.checked": 2,
    "markup.list.unchecked": 7,
