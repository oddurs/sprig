{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sprig",
  "scopeName": "source.sprig",
  "fileTypes": ["sprig"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#escaped-note" },
    { "include": "#answer" },
    { "include": "#item" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.sprig",
      "match": "^\\s*//.*$"
    },
    "escaped-note": {
      "match": "^(\\s*)(\\\\)(.*)$",
      "captures": {
        "2": { "name": "constant.character.escape.sprig" }
      }
    },
    "answer": {
      "begin": "^(\\s*)(=)(?=\\s|$)",
      "beginCaptures": { "2": { "name": "keyword.operator.answer.sprig" } },
      "end": "$",
      "contentName": "markup.italic.answer.sprig",
      "patterns": [{ "include": "#tokens" }]
    },
    "item": {
      "patterns": [
        { "include": "#mark-done" },
        { "include": "#mark-dropped" },
        { "include": "#mark-group" },
        { "include": "#mark-graft" },
        { "include": "#mark-question" },
        { "include": "#mark-open" }
      ]
    },
    "mark-open": {
      "begin": "^(\\s*)([-~>])(?=\\s|$)",
      "beginCaptures": { "2": { "name": "keyword.control.mark.sprig" } },
      "end": "$",
      "patterns": [{ "include": "#tokens" }]
    },
    "mark-done": {
      "begin": "^(\\s*)(x)(?=\\s|$)",
      "beginCaptures": { "2": { "name": "markup.inserted.mark.done.sprig" } },
      "end": "$",
      "patterns": [{ "include": "#tokens" }]
    },
    "mark-dropped": {
      "begin": "^(\\s*)(/)(?=\\s|$)",
      "beginCaptures": { "2": { "name": "markup.deleted.mark.dropped.sprig" } },
      "end": "$",
      "contentName": "markup.strikethrough.sprig",
      "patterns": [{ "include": "#tokens" }]
    },
    "mark-question": {
      "begin": "^(\\s*)(\\?)(?=\\s|$)",
      "beginCaptures": { "2": { "name": "keyword.operator.question.sprig" } },
      "end": "$",
      "patterns": [{ "include": "#tokens" }]
    },
    "mark-group": {
      "begin": "^(\\s*)(#)(?=\\s|$)",
      "beginCaptures": { "2": { "name": "punctuation.definition.heading.sprig" } },
      "end": "$",
      "contentName": "markup.heading.group.sprig",
      "patterns": [{ "include": "#tokens" }]
    },
    "mark-graft": {
      "begin": "^(\\s*)(\\+)(?=\\s|$)",
      "beginCaptures": { "2": { "name": "keyword.control.graft.sprig" } },
      "end": "$",
      "patterns": [{ "include": "#tokens" }]
    },
    "tokens": {
      "patterns": [
        {
          "name": "variable.other.person.sprig",
          "match": "(?<=^|\\s)@[\\w.\\-]+(?=\\s|$)"
        },
        {
          "name": "entity.name.tag.sprig",
          "match": "(?<=^|\\s)#[\\w\\-]+(?=\\s|$)"
        },
        {
          "name": "entity.name.label.anchor.sprig",
          "match": "(?<=^|\\s)\\^[\\w\\-]+(?=\\s|$)"
        },
        {
          "name": "keyword.other.priority.sprig",
          "match": "(?<=^|\\s)!{1,3}(?=\\s|$)"
        },
        {
          "match": "(?<=^|\\s)([A-Za-z][\\w\\-]*)(:)(\"[^\"]*\"|(?!//)\\S+)",
          "captures": {
            "1": { "name": "support.type.property-name.sprig" },
            "2": { "name": "punctuation.separator.key-value.sprig" },
            "3": {
              "name": "string.unquoted.value.sprig",
              "patterns": [{ "include": "#link" }]
            }
          }
        },
        { "include": "#link" }
      ]
    },
    "link": {
      "name": "markup.underline.link.sprig",
      "match": "\\[\\[[^\\]]+\\]\\]"
    }
  }
}
