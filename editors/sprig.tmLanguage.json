{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sprig",
  "scopeName": "source.sprig",
  "fileTypes": [
    "sprig"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#escaped-note"
    },
    {
      "include": "#answer"
    },
    {
      "include": "#item"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.sprig",
      "match": "^\\s*//.*$"
    },
    "escaped-note": {
      "match": "^(\\s*)(\\\\)(.*)$",
      "captures": {
        "2": {
          "name": "constant.character.escape.sprig"
        }
      }
    },
    "answer": {
      "begin": "^(\\s*)(=)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "keyword.mark.answer.sprig"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#tokens"
        }
      ],
      "contentName": "markup.italic.answer.sprig"
    },
    "item": {
      "patterns": [
        {
          "include": "#mark-todo"
        },
        {
          "include": "#mark-doing"
        },
        {
          "include": "#mark-done"
        },
        {
          "include": "#mark-dropped"
        },
        {
          "include": "#mark-later"
        },
        {
          "include": "#mark-ask"
        },
        {
          "include": "#mark-group"
        },
        {
          "include": "#mark-graft"
        }
      ]
    },
    "tokens": {
      "patterns": [
        {
          "name": "variable.other.person.sprig",
          "match": "(?<=^|\\s)@[\\w.\\-]+(?=\\s|$)"
        },
        {
          "name": "entity.name.tag.sprig",
          "match": "(?<=^|\\s)#[\\w\\-]+(?=\\s|$)"
        },
        {
          "name": "entity.name.label.anchor.sprig",
          "match": "(?<=^|\\s)\\^[\\w\\-]+(?=\\s|$)"
        },
        {
          "name": "keyword.other.priority.sprig",
          "match": "(?<=^|\\s)!{1,3}(?=\\s|$)"
        },
        {
          "match": "(?<=^|\\s)([A-Za-z][\\w\\-]*)(:)(\"[^\"]*\"|(?!//)\\S+)",
          "captures": {
            "1": {
              "name": "support.type.property-name.sprig"
            },
            "2": {
              "name": "punctuation.separator.key-value.sprig"
            },
            "3": {
              "name": "string.unquoted.value.sprig",
              "patterns": [
                {
                  "include": "#link"
                }
              ]
            }
          }
        },
        {
          "include": "#link"
        }
      ]
    },
    "link": {
      "name": "markup.underline.link.sprig",
      "match": "\\[\\[[^\\]]+\\]\\]"
    },
    "mark-todo": {
      "begin": "^(\\s*)(-)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "keyword.mark.todo.sprig"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#tokens"
        }
      ]
    },
    "mark-doing": {
      "begin": "^(\\s*)(~)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "keyword.mark.doing.sprig"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#tokens"
        }
      ]
    },
    "mark-later": {
      "begin": "^(\\s*)(>)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "keyword.mark.later.sprig"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#tokens"
        }
      ]
    },
    "mark-done": {
      "begin": "^(\\s*)(x)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "keyword.mark.done.sprig"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#tokens"
        }
      ],
      "contentName": "markup.done.sprig"
    },
    "mark-dropped": {
      "begin": "^(\\s*)(/)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "keyword.mark.dropped.sprig"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#tokens"
        }
      ],
      "contentName": "markup.strikethrough.sprig"
    },
    "mark-ask": {
      "begin": "^(\\s*)(\\?)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "keyword.mark.ask.sprig"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#tokens"
        }
      ]
    },
    "mark-group": {
      "begin": "^(\\s*)(#)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "keyword.mark.group.sprig"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#tokens"
        }
      ],
      "contentName": "markup.heading.group.sprig"
    },
    "mark-graft": {
      "begin": "^(\\s*)(\\+)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "keyword.mark.graft.sprig"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#tokens"
        }
      ]
    }
  }
}
