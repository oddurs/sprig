    "person": {
      "type": "PATTERN",
      "value": "@[\\p{L}\\p{N}_.\\-]+"
    },
    "tag": {
      "type": "PATTERN",
      "value": "#[\\p{L}\\p{N}_\\-]+"
    },
    "anchor": {
      "type": "PATTERN",
      "value": "\\^[\\p{L}\\p{N}_\\-]+"
    },
    "priority": {
      "type": "PATTERN",
      "value": "!{1,3}"
    },
    "after": {
      "type": "PATTERN",
      "value": "[aA][fF][tT][eE][rR]:(\"[^\"\\n]*\"\\S*|[^\\s\\/\"]\\S*|\\/[^\\s\\/]\\S*|\\/|\"\\S*)"
    },
    "field": {
      "type": "PATTERN",
      "value": "\\p{L}[\\p{L}\\p{N}_\\-]*:(\"[^\"\\n]*\"\\S*|[^\\s\\/\"]\\S*|\\/[^\\s\\/]\\S*|\\/|\"\\S*)"
    },
    "link": {
      "type": "PATTERN",
      "value": "\\[\\[[^\\]\\s]+\\]\\]"
    },
    "word": {
      "type": "PATTERN",
      "value": "[^\\s\"]*\"[^\"\\r\\n]*\"\\S*|\\S+"
    },
    "_ws": {
      "type": "PATTERN",
      "value": "[^\\S\\r\\n]+"
    },
    "_nl": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    }
