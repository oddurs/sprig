{
  "name": "chea",
  "displayName": "Chea",
  "description": "Plain-text plans: highlighting, problems as you type, completion and ticking for .chea files",
  "version": "0.0.0",
  "publisher": "oddurs",
  "license": "MIT",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/oddurs/chea" },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Programming Languages", "Formatters"],
  "activationEvents": ["workspaceContains:**/*.chea"],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "chea",
        "aliases": ["Chea", "chea"],
        "extensions": [".chea"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      { "language": "chea", "scopeName": "source.chea", "path": "./syntaxes/chea.tmLanguage.json" }
    ],
    "configuration": {
      "title": "Chea",
      "properties": {
        "chea.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "The `chea` binary to run as the language server. Empty uses the one bundled with the extension, then `chea` on your `PATH`."
        }
      }
    }
  },
  "scripts": {
    "prepare-grammar": "node scripts/prepare.js",
    "test": "node scripts/prepare.js && node test/run.js",
    "package": "node scripts/prepare.js && vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0"
  },
  "overrides": {
    "@azure/msal-node": "7.1.2",
    "minimatch": "11.0.4"
  }
}
