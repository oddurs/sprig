{
  "comments": { "lineComment": "//" },
  "brackets": [["[[", "]]"]],
  "autoClosingPairs": [{ "open": "[[", "close": "]]" }, { "open": "\"", "close": "\"" }],
  "surroundingPairs": [["\"", "\""]],
  "indentationRules": { "increaseIndentPattern": "^\\s*[-~x/>?#+](\\s|$)", "decreaseIndentPattern": "^$" },
  "onEnterRules": [
    { "beforeText": "^\\s*[-~x/>?](\\s|$)", "action": { "indent": "none", "appendText": "- " } }
  ],
  "wordPattern": "[@#^]?[\\p{L}\\p{N}_.\\-]+"
}
