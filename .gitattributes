# One line ending everywhere, so a checkout on another platform does not churn.
* text=auto eol=lf

# Conformance inputs are byte-exact: some examples are deliberately written
# with CRLF endings or a BOM, and normalising them would delete the test.
tests/conformance/** -text

# The draft 0.2 design pages, kept as the behavioural oracle for the spec.
design/** linguist-documentation

# Not written by hand, and not worth reviewing line by line.
Cargo.lock linguist-generated=true
ROADMAP.md linguist-generated=true

# ROADMAP.md is generated from the items. On a merge, re-derive it rather than
# reconciling two renderings of different inputs.
ROADMAP.md merge=cairn

# An item is the source, so it cannot be re-derived. The driver unions its
# sequence fields and leaves everything else to a person.
cairn/items/*.md text eol=lf merge=cairn

# An item is the source rather than a rendering, so it cannot be re-derived.
# The driver unions its sequence fields, where two branches both meant what
# they added, and leaves everything else to a person.
cairn/items/*.md merge=cairn
