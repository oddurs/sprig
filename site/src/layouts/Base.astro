---
import '../styles/tokens.css';
import '../styles/view.css';
import '../styles/site.css';

interface Props {
	title: string;
	description: string;
	current?: 'home' | 'play';
}
const { title, description, current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path: string) => `${base}${path}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('/og.png'), Astro.site);
const repo = 'https://github.com/oddurs/sprig';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
		<link rel="alternate" type="application/atom+xml" title="Sprig releases" href={url('/feed.xml')} />
		<link rel="sitemap" href={url('/sitemap-index.xml')} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Sprig" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1280" />
		<meta property="og:image:height" content="640" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImage} />
		{/* The docs' theme picker stores a choice; honour it here too. Without it, the OS setting decides. */}
		<script is:inline>
			try {
				const t = localStorage.getItem('starlight-theme');
				if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
			} catch {}
		</script>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<header class="site-head">
			<div class="wrap">
				<a class="brand" href={url('/')}>
					<img src={url('/favicon.svg')} alt="" width="28" height="28" />
					<span>Sprig</span>
					<span class="ver">draft 0.3</span>
				</a>
				<nav class="site-nav" aria-label="Site">
					<a href={url('/docs/first-plan/')}>Docs</a>
					<a href={url('/spec/')}>Spec</a>
					<a href={url('/play/')} aria-current={current === 'play' ? 'page' : undefined}>Playground</a>
					<a href={url('/decisions/')}>Decisions</a>
					<a href={repo}>GitHub</a>
				</nav>
			</div>
		</header>
		<main id="main">
			<slot />
		</main>
		<footer class="site-foot">
			<div class="wrap">
				<span>Spec: CC0 · Code: MIT · No cookies, no analytics, no third-party requests.</span>
				<nav aria-label="Project">
					<a href={url('/roadmap/')}>Roadmap</a>
					<a href={url('/changelog/')}>Changelog</a>
					<a href={url('/feed.xml')}>Atom feed</a>
					<a href={url('/compare/')}>Compare</a>
					<a href={`${repo}/blob/main/SECURITY.md`}>Security</a>
					<a href={repo}>GitHub</a>
				</nav>
			</div>
		</footer>
	</body>
</html>
