---
// A plan as Sprig reads it: the tree or the next-up list, rendered at build
// time by the parser. The same markup the playground renders in the browser.
import { render } from '../lib/render.js';

interface Props {
	files: Record<string, string>;
	active: string;
	view?: 'tree' | 'next';
	caption?: string;
}
const { files, active, view = 'tree', caption } = Astro.props;
const { html } = render(files, active, view);
---

<figure class="sp-plan">
	{caption && <figcaption>{caption}</figcaption>}
	<div class="sv" set:html={html} />
</figure>

<style>
	.sp-plan {
		margin: 0;
		min-width: 0;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		padding: var(--space-2) var(--space-4) var(--space-4);
	}
	figcaption {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--text-muted);
		padding: var(--space-2) 0 var(--space-3);
		border-bottom: 1px solid var(--border);
		margin-bottom: var(--space-2);
	}
</style>
