---
// A terminal screen: a command and what it prints. Pass `html` from
// lib/terminal.js for parser output, or `command` for a line to type.
import { esc } from '../lib/sprig.js';

interface Props {
	html?: string;
	command?: string;
	title?: string;
	mono?: boolean;
}
const { html, command, title, mono = false } = Astro.props;
const body = html ?? `<span class="t-dim">$ </span>${esc(command ?? '')}`;
---

<figure class="sp-term">
	{title && <figcaption>{title}</figcaption>}
	{/* Wide screens scroll sideways on phones; tabindex lets a keyboard do it too. */}
	<pre class:list={['st', { mono, wrap: command !== undefined }]} tabindex="0" set:html={body} />
</figure>

<style>
	.sp-term {
		margin: 0;
		min-width: 0;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		background: var(--surface-raised);
		overflow: hidden;
	}
	figcaption {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--text-muted);
		padding: var(--space-2) var(--space-4);
		border-bottom: 1px solid var(--border);
	}
	pre {
		margin: 0;
		padding: var(--space-4);
		overflow-x: auto;
	}
	/* A typed command wraps rather than scroll; output keeps its columns. */
	.st.wrap {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	pre:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: -2px;
	}
</style>
