---
// "Open in the playground" for a docs example. The whole example travels in
// the link's fragment, so the tutorial's steps need no server and no storage.
import { planFragment } from '../lib/share.js';

interface Props {
	files: Record<string, string>;
	label?: string;
}
const { files, label = 'Open this in the playground' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/play/#${planFragment(files)}`;
---

<p><a class="sp-play-link" href={href}>{label} →</a></p>

<style>
	/* A link on a line of its own is a control, not a word in a sentence, so by
	   touch it is a full target tall. */
	@media (max-width: 859px), (pointer: coarse) {
		.sp-play-link {
			display: inline-flex;
			align-items: center;
			min-height: var(--target);
		}
	}
</style>
