---
import Base from '../layouts/Base.astro';
import { highlight, render } from '../lib/render.js';

// A 404 written in Sprig, rendered by the same parser as everything else: the
// page you wanted is blocked on a link that doesn't exist.
const plan = `Page not found  @you

- Find the page you wanted  after:^link
- Check the link that brought you here  ^link
  Something pointed at a page that doesn't exist.
- Start again from the front page`;
const view = render({ '404.sprig': plan }, '404.sprig');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Page not found · Sprig" description="This page doesn't exist.">
	<div class="wrap">
		<section class="lost">
			<div>
				<p class="eyebrow">404</p>
				<h1>This page is blocked.</h1>
				<p class="lede">It waits on a link that points nowhere. The plan on the right says so, computed by the same parser as the rest of the site.</p>
				<div class="btns">
					<a class="btn primary" href={`${base}/`}>Front page</a>
					<a class="btn" href={`${base}/docs/first-plan/`}>Docs</a>
				</div>
			</div>
			<div>
				<figure class="code-card"><figcaption><b>404.sprig</b></figcaption><pre class="sc" set:html={highlight(plan)} /></figure>
				<div class="rendered sv" style="margin-top:14px"><Fragment set:html={view.html} /></div>
			</div>
		</section>
	</div>
</Base>
