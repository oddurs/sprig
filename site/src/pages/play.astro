---
import Plan from '../components/Plan.astro';
import Inline from '../components/primitives/Inline.astro';
import Stack from '../components/primitives/Stack.astro';
import Text from '../components/primitives/Text.astro';
import examples from '../generated/examples.json';
import Base from '../layouts/Base.astro';
import { shiftExamples } from '../lib/dates.js';
import { highlight, render } from '../lib/render.js';

// The page is an app, but it still arrives complete: the example workspace is
// rendered at build time, so a reader without JavaScript sees the plan and its
// computed view before being told the editor needs a script.
const order = ['bakery.sprig', 'lease.sprig', 'kitchen.sprig', 'launch.sprig', 'groceries.sprig', 'dana.sprig'];
const files = shiftExamples(examples as Record<string, string>, new Date());
const view = render(files, order[0]);
---

<Base
	title="Playground · Sprig"
	description="Write a Sprig plan across several files and see what is done, blocked and next, computed as you type. Share it as a link; nothing is uploaded."
	current="play"
>
	<div class="intro">
		<Stack gap={3}>
			<Text as="h1" size="2xl" weight="bold">Playground</Text>
			<Text size="md" tone="muted" measure>Six linked files for opening a bakery. Edit any of them, tick a mark in the view, or start a file of your own. Share copies a link that holds the whole workspace; nothing is uploaded.</Text>
		</Stack>
	</div>
	<noscript><Plan files={files} active={order[0]} caption="bakery.sprig, as Sprig reads it. The editor needs JavaScript." /></noscript>
	<div class="pg" id="pg">
		<div class="src">
			<div class="tabbar">
				<div class="tabs" id="tabs" role="tablist" aria-label="Files">
					{order.map((f, i) => <button type="button" class="tab" role="tab" data-file={f} aria-selected={i === 0 ? 'true' : 'false'}>{f}</button>)}
				</div>
				<div class="newfile" id="newFile"></div>
			</div>
			<div class="ed">
				<pre class="sc" id="hl" aria-hidden="true" set:html={highlight(files[order[0]]) + '\n\n'} />
				<textarea id="src" spellcheck="false" wrap="off" autocapitalize="off" autocomplete="off" aria-label="Sprig source">{files[order[0]]}</textarea>
			</div>
			<div class="edfoot">
				<span class="keys"><kbd>Tab</kbd> indent · <kbd>⇧Tab</kbd> outdent · <kbd id="modkey">⌘</kbd><kbd>↵</kbd> cycle - ~ x · type <kbd>due:fri</kbd>, then <kbd>↵</kbd></span>
				<Inline gap={2}>
					<span class="toast" id="toast" role="status"></span>
					<button class="small" id="share" type="button">Share</button>
					<button class="small" id="reset" type="button">Reset</button>
				</Inline>
			</div>
		</div>
		<div class="rv" id="rv">
			<div class="rv-head" id="rvHead">
				<div class="rv-file">{order[0]}</div>
				<h2>{view.doc.title}</h2>
			</div>
			<div class="rv-tools">
				<div class="seg" role="group" aria-label="View">
					<button type="button" data-vm="tree" aria-pressed="true">Tree</button>
					<button type="button" data-vm="next" aria-pressed="false">Next up</button>
				</div>
				<div class="people" id="people" role="group" aria-label="Filter by person"></div>
				<label class="hd"><input type="checkbox" id="hideDone" /> Hide done</label>
			</div>
			<div class="rv-body sv" id="rvBody" set:html={view.html} />
		</div>
	</div>
	<Text size="sm" tone="muted">Runs the draft reference parser until the Rust core ships.</Text>
	<script type="application/json" id="examples" set:html={JSON.stringify({ files: examples, order })} />
	<script>
		import '../scripts/play.js';
	</script>
</Base>

<style>
	.intro {
		padding-block: var(--space-8) var(--space-6);
	}
	.pg {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		height: min(760px, calc(100vh - 140px));
		min-height: 560px;
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		overflow: hidden;
		margin-bottom: var(--space-3);
	}
	noscript :global(.plan) {
		margin-bottom: var(--space-5);
	}
	.src {
		display: flex;
		flex-direction: column;
		min-height: 0;
		min-width: 0;
		background: var(--surface-raised);
		border-right: 1px solid var(--border);
	}
	.tabbar {
		display: flex;
		align-items: stretch;
		gap: var(--space-4);
		padding: 0 var(--space-4);
		border-bottom: 1px solid var(--border);
		flex: none;
	}
	.tabs {
		position: relative;
		display: flex;
		gap: var(--space-4);
		overflow-x: auto;
		min-width: 0;
	}
	.newfile {
		display: flex;
		align-items: center;
		flex: none;
	}
	.pg :global(.tab) {
		flex: none;
		background: none;
		border: 0;
		border-bottom: 2px solid transparent;
		padding: var(--space-3) 0;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--text-muted);
		cursor: pointer;
		white-space: nowrap;
	}
	.pg :global(.tab:hover) {
		color: var(--text);
	}
	.pg :global(.tab[aria-selected='true']) {
		color: var(--text);
		border-bottom-color: var(--text);
	}
	.pg :global(.tab-input) {
		flex: none;
		width: 140px;
		margin: var(--space-2) 0;
		background: var(--surface);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
		color: var(--text);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		padding: var(--space-1) var(--space-2);
	}
	.ed {
		position: relative;
		flex: 1;
		min-height: 0;
	}
	.ed pre,
	.ed textarea {
		position: absolute;
		inset: 0;
		margin: 0;
		border: 0;
		padding: var(--space-4);
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		line-height: var(--leading-md);
		letter-spacing: 0;
		tab-size: 2;
		white-space: pre;
		overflow-wrap: normal;
	}
	.ed pre {
		overflow: hidden;
		pointer-events: none;
		padding-bottom: var(--space-8);
		padding-right: var(--space-8);
	}
	.ed textarea {
		width: 100%;
		height: 100%;
		overflow: auto;
		resize: none;
		background: transparent;
		color: transparent;
		-webkit-text-fill-color: transparent;
		caret-color: var(--text);
		outline: none;
	}
	.ed:focus-within {
		box-shadow: inset 0 0 0 2px var(--focus);
	}
	.edfoot {
		flex: none;
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-3);
		padding: var(--space-2) var(--space-4);
		border-top: 1px solid var(--border);
		font-size: var(--text-xs);
		color: var(--text-muted);
	}
	kbd {
		font-family: var(--font-mono);
		color: var(--text);
	}
	.small {
		background: none;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
		padding: var(--space-1) var(--space-2);
		font: inherit;
		font-size: var(--text-xs);
		color: var(--text);
		cursor: pointer;
	}
	.small:hover {
		border-color: var(--text);
	}
	.pg :global(.small.armed) {
		border-color: var(--mark-graft);
	}
	.toast {
		font-family: var(--font-mono);
		color: var(--text-muted);
	}

	.rv {
		display: flex;
		flex-direction: column;
		min-height: 0;
		min-width: 0;
	}
	.rv-head {
		flex: none;
		padding: var(--space-4) var(--space-5) var(--space-3);
		border-bottom: 1px solid var(--border);
	}
	.pg :global(.rv-file) {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--text-muted);
		margin-bottom: var(--space-2);
	}
	.pg :global(.rv-head h2) {
		font-size: var(--text-lg);
		font-weight: var(--weight-bold);
		letter-spacing: -0.015em;
		margin: 0 0 var(--space-2);
	}
	.pg :global(.props) {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-4);
		margin: 0 0 var(--space-2);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
	}
	.pg :global(.props div) {
		display: flex;
		gap: var(--space-2);
	}
	.pg :global(.props dt),
	.pg :global(.props .rel) {
		color: var(--text-muted);
	}
	.pg :global(.props dd) {
		margin: 0;
	}
	.pg :global(.rv-notes) {
		font-size: var(--text-sm);
		color: var(--text-muted);
		max-width: var(--measure-prose);
		margin-bottom: var(--space-3);
	}
	.pg :global(.rv-notes p) {
		margin: 0 0 var(--space-1);
	}
	.pg :global(.big) {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}
	.pg :global(.big .bar) {
		flex: 1;
		height: 4px;
		display: flex;
		border-radius: var(--radius-full);
		background: var(--border);
		overflow: hidden;
	}
	.pg :global(.big .bar i) {
		display: block;
		background: var(--mark-done);
	}
	.pg :global(.big .bar b) {
		display: block;
		background: var(--mark-doing);
	}
	.pg :global(.big .pct) {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		font-variant-numeric: tabular-nums;
	}
	.pg :global(.stats) {
		margin: var(--space-2) 0 0;
		font-size: var(--text-xs);
		color: var(--text-muted);
		font-variant-numeric: tabular-nums;
	}
	.pg :global(.stats b) {
		color: var(--text);
	}
	.rv-tools {
		flex: none;
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-4);
		padding: var(--space-2) var(--space-5);
		border-bottom: 1px solid var(--border);
	}
	.seg {
		display: inline-flex;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-md);
		overflow: hidden;
	}
	.seg button {
		background: none;
		border: 0;
		padding: var(--space-1) var(--space-3);
		font: inherit;
		font-size: var(--text-xs);
		color: var(--text-muted);
		cursor: pointer;
	}
	.seg button[aria-pressed='true'] {
		background: var(--text);
		color: var(--surface);
	}
	.people {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
	.pg :global(.pchip) {
		background: none;
		border: 1px solid var(--border);
		border-radius: var(--radius-full);
		padding: 0 var(--space-2);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		line-height: var(--leading-md);
		color: var(--text-muted);
		cursor: pointer;
	}
	.pg :global(.pchip[aria-pressed='true']) {
		border-color: var(--text);
		color: var(--text);
	}
	.hd {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-size: var(--text-xs);
		color: var(--text-muted);
		margin-left: auto;
		cursor: pointer;
	}
	.rv-body {
		flex: 1;
		min-height: 0;
		overflow: auto;
		padding: var(--space-2) var(--space-5) var(--space-6);
	}

	@media (max-width: 859px) {
		.pg {
			grid-template-columns: minmax(0, 1fr);
			height: auto;
		}
		.src {
			border-right: 0;
			border-bottom: 1px solid var(--border);
		}
		.ed {
			flex: none;
			height: 420px;
		}
		.rv-body {
			flex: none;
			max-height: 640px;
		}
	}
	@media (max-width: 559px) {
		.ed pre,
		.ed textarea {
			font-size: var(--text-base);
		}
		.rv-head,
		.rv-tools,
		.rv-body {
			padding-inline: var(--space-4);
		}
		.hd {
			margin-left: 0;
		}
	}
</style>
