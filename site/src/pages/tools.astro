---
import Button from '../components/Button.astro';
import Section from '../components/Section.astro';
import Surfaces from '../components/Surfaces.astro';
import Terminal from '../components/Terminal.astro';
import Grid from '../components/primitives/Grid.astro';
import Inline from '../components/primitives/Inline.astro';
import Stack from '../components/primitives/Stack.astro';
import Text from '../components/primitives/Text.astro';
import examples from '../generated/examples.json';
import Base from '../layouts/Base.astro';
import { screen } from '../lib/terminal.js';
import { frame, initialState } from '../lib/tui.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path: string) => `${base}${path}`;
const repo = 'https://github.com/oddurs/sprig';

// Every screen is the reference parser's reading of examples/bakery, with the
// date pinned, so nothing here is drawn by hand.
const files: Record<string, string> = examples;
const next = screen('next', files, { limit: 6, compact: true });
const tree = screen('tree', files, 'kitchen.sprig');
const why = screen('why', files, 'kitchen.sprig', 'Tiling');
const status = screen('status', files);
const colour = screen('tree', files, 'lease.sprig');
const mono = screen('tree', files, 'lease.sprig', { env: 'NO_COLOR=1 ' });
// Two planted mistakes, so check has something to say.
const broken = {
	...files,
	'bakery.sprig': files['bakery.sprig'].replace('+ [[kitchen]]', '+ [[kitchn]]'),
	'lease.sprig': files['lease.sprig'].replace('after:^permit', 'after:^permt'),
};
const check = screen('check', broken);
const tui = frame(initialState(), files);

type Cmd = { sig: string; when: string; body: string };
const groups: { name: string; note: string; cmds: Cmd[] }[] = [
	{
		name: 'Read',
		note: 'answer a question, change nothing',
		cmds: [
			{ sig: 'sprig next', when: 'v0.1', body: 'Open, unblocked work: in progress first, then priority, then due date.' },
			{ sig: 'sprig tree', when: 'v0.2', body: 'The plan as Sprig reads it, grafts expanded, progress rolled up.' },
			{ sig: 'sprig status', when: 'v0.2', body: 'The whole folder on one screen; --oneline for a prompt or tmux.' },
			{ sig: 'sprig why <ref>', when: 'v0.2', body: 'What an item waits on, all the way down, with file and line.' },
			{ sig: 'sprig find <query>', when: 'v0.3', body: 'Search by text, @who, #tag, is:blocked, due:<fri.' },
			{ sig: 'sprig agenda', when: 'v0.3', body: 'Dated work by day across every file.' },
		],
	},
	{
		name: 'Check',
		note: 'fail loudly, fix nothing silently',
		cmds: [
			{ sig: 'sprig check', when: 'v0.1', body: 'Broken links, loops and unknown anchors as file:line:col. Exit 1 on any error.' },
			{ sig: 'sprig fmt', when: 'v0.2', body: 'Two spaces per level, typed dates expanded to ISO. --check for CI.' },
		],
	},
	{
		name: 'Write',
		note: 'one line at a time',
		cmds: [
			{ sig: 'sprig tick <ref>', when: 'v0.2', body: 'Done, or reopen. A recurring item moves its due date instead.' },
			{ sig: 'sprig mark <ref> <mark>', when: 'v0.3', body: 'Set any status: started, parked for later, dropped.' },
			{ sig: 'sprig answer <ref> "text"', when: 'v0.3', body: 'Settle a question, and see what it unblocked.' },
			{ sig: 'sprig add "text" --under <ref>', when: 'v0.3', body: 'Append an item, indented to match the file.' },
			{ sig: 'sprig edit <ref>', when: 'v0.3', body: 'Open $EDITOR at the item’s line.' },
		],
	},
	{
		name: 'Connect',
		note: 'other tools, other formats',
		cmds: [
			{ sig: 'sprig export', when: 'v0.3', body: 'The resolved tree as JSON; due dates as an iCalendar feed.' },
			{ sig: 'sprig import', when: 'v0.3', body: 'Markdown checkboxes in, a Sprig file out.' },
			{ sig: 'sprig graph', when: 'v0.3', body: 'The dependency graph for Graphviz or Mermaid.' },
			{ sig: 'sprig mcp', when: 'v0.3', body: 'The plans, served to coding agents.' },
			{ sig: 'sprig completions', when: 'v0.2', body: 'Completion that knows your anchors and people, and a man page.' },
		],
	},
];

const refs = [
	['^signed', 'An anchor, searched across the folder', 'sprig tick ^signed'],
	['lease^signed', 'An anchor in one file', 'sprig why lease^signed'],
	['lease.sprig:13', 'A line, the way compilers print one', 'sprig tick lease.sprig:13'],
	['"grease trap"', 'Words from exactly one item’s text', 'sprig answer "grease trap" "Landlord pays"'],
	['-', 'Refs on stdin, one per line', 'sprig next --plain | cut -f1 | sprig tick -'],
];

// Rules are prose with `code` spans.
const code = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/`([^`]+)`/g, '<code>$1</code>');
const rules = [
	['The file is the truth', 'Tools compute progress and blockers; they never store them. Delete every tool and the plan still reads.'],
	['A write touches one line', '`tick`, `add` and `answer` change only the bytes they mean to, so `git diff` shows exactly what happened.'],
	['Three kinds of output', 'Aligned for people, tab-separated with `--plain`, the whole tree with `--json`. The `--plain` columns are covered by the stability policy.'],
	['Exit codes mean something', '`0` fine, `1` the answer is no, `2` you asked wrong. Scripts branch on them.'],
	['Every answer is reproducible', '`--today` pins the date, so any output can be tested, diffed and pasted into a bug report.'],
	['Nothing to set up', 'No config file, no daemon, no plugins, no network. Flags and environment variables only.'],
];

const recipes = [
	['Pick and tick with fzf', 'The first column of --plain is always a ref.', 'sprig next --plain | fzf | cut -f1 | sprig tick -'],
	['Gate a commit', 'A pre-commit hook that checks only the plans that changed.', "git diff --cached --name-only -- '*.sprig' | xargs sprig check --strict"],
	['Deadlines in any calendar', 'Regenerate on a timer; the calendar subscribes to the file.', 'sprig export --format ics > ~/Sync/plans.ics'],
	['Your next task in the prompt', 'For Starship, tmux, or any prompt that runs a command.', 'sprig next @me --limit 1 --plain | cut -f2'],
];

const keys = [
	['j k', 'move'],
	['h l', 'fold, unfold'],
	['x', 'tick'],
	['~', 'mark doing'],
	['1 2 3', 'tree, next up, agenda'],
	['/', 'filter'],
	['?', 'help'],
];
const strip = ['k', 'j', 'h', 'l', 'x', '~', '1', '2', '3', '/', '?'];
---

<Base
	title="Tools · Sprig"
	description="The Sprig toolchain: one small binary with verbs that read a folder of plans, an editor language server, an agent server and a TUI, all built on one parser. What exists today and when each piece lands."
	current="tools"
>
	<section class="hero" aria-labelledby="tools-h">
		<Stack gap={6}>
			<Stack gap={5}>
				<Text size="sm" tone="muted">The toolchain</Text>
				<Text as="h1" id="tools-h" size="2xl" weight="bold">A toolbelt, not an app.</Text>
				<Text size="md" tone="muted" measure>Sprig is a file format first. The tools around it are small, read the same files, and agree with each other because they share one parser. None of them needs an account, a server or a config file.</Text>
				<Text size="sm" measure>Nothing here is installable yet. The first release, v0.1, ships <code>sprig next</code> and <code>sprig check</code>; the rest arrive milestone by milestone.</Text>
			</Stack>
			<Inline gap={3}>
				<Button href={url('/roadmap/')}>The roadmap</Button>
				<Button href={repo} variant="ghost">GitHub</Button>
			</Inline>
		</Stack>
		<Terminal html={next.html} title="~/bakery" />
	</section>

	<Section id="surfaces-h" title="One core, every surface." intro="The parser is a Rust library that touches no files, clock or network. It compiles to a native binary and to WebAssembly, so the terminal, your editor, a coding agent and this site give the same answer about the same file.">
		<div class="narrow"><Surfaces /></div>
	</Section>

	<Section id="cli-h" title="Small verbs, one question each." intro="Every command reads a folder of plans and answers one thing, in text a person can read and a pipe can parse. The screens below are the reference parser’s output for the example bakery plans, with the date pinned by --today the way the tests will run.">
		<Grid cols={2} gap={7} rowGap={7}>
			{
				groups.map((g) => (
					<Stack gap={3}>
						<Inline gap={3} align="baseline">
							<Text as="h3" size="md" weight="bold">{g.name}</Text>
							<Text size="sm" tone="muted">{g.note}</Text>
						</Inline>
						<dl class="cmds">
							{g.cmds.map((c) => (
								<div class="cmd">
									<dt>
										<code>{c.sig}</code>
										<span class="when">{c.when}</span>
									</dt>
									<dd>{c.body}</dd>
								</div>
							))}
						</dl>
					</Stack>
				))
			}
		</Grid>
		<Terminal html={tree.html} />
		<Grid cols={2} gap={5} rowGap={5}>
			<Stack gap={3}>
				<Terminal html={why.html} />
				<Text size="sm" tone="muted">Tiling isn’t blocked on its own. Its parent is, and the chain crosses into another file.</Text>
			</Stack>
			<Stack gap={3}>
				<Terminal html={check.html} />
				<Text size="sm" tone="muted">Two mistakes planted in a copy of the plans. Editors and CI jump straight to file:line:col.</Text>
			</Stack>
		</Grid>
		<Terminal html={status.html} />
	</Section>

	<Section id="rules-h" title="The rules every tool keeps." intro="These decide every command. Where a feature would break one, the feature loses.">
		<Grid cols={3} gap={6} rowGap={7}>
			{
				rules.map(([title, body]) => (
					<Stack gap={2}>
						<Text as="h3" size="md" weight="bold">{title}</Text>
						<Text tone="muted"><Fragment set:html={code(body)} /></Text>
					</Stack>
				))
			}
		</Grid>
		<a class="text-link" href={url('/decisions/#the-cli-has-no-config-file-daemon-plugins-or-network')}>Why there’s no config file</a>
	</Section>

	<Section id="colour-h" title="Colour is a courtesy." intro="Every screen takes its colour from the nine marks and nothing else. Set NO_COLOR and nothing is lost, because the character already is the status.">
		<Grid cols={2} gap={5}>
			<Terminal html={colour.html} title="colour" />
			<Terminal html={mono.html} title="NO_COLOR=1" mono />
		</Grid>
	</Section>

	<Section id="refs-h" title="Pointing at an item from the shell." intro="Commands that act on one item take a ref. The forms run from exact to forgiving, and an ambiguous ref lists its candidates and exits 2 rather than guessing.">
		<div class="table">
			<table>
				<thead>
					<tr><th scope="col">Ref</th><th scope="col">Means</th><th scope="col">Example</th></tr>
				</thead>
				<tbody>
					{refs.map(([ref, means, eg]) => (
						<tr><td><code>{ref}</code></td><td>{means}</td><td><code>{eg}</code></td></tr>
					))}
				</tbody>
			</table>
		</div>
	</Section>

	<Section id="tui-h" title="The same verbs, on one screen." intro="sprig tui shows the tree, what’s next and the agenda, with vim keys. Its writes go through the same one-line edits as the commands, and it reloads when an editor or an agent changes a file underneath it. This one runs the reference parser: focus it and use the keys.">
		<div class="tui-wrap">
			<Stack gap={3}>
				<div class="tui" id="tui" tabindex="0" role="application" aria-label="sprig tui demo" aria-describedby="tui-help" set:html={tui} />
				<div class="strip" id="tui-keys" aria-label="Keys">
					{strip.map((k) => <button type="button" data-key={k} aria-label={`Press ${k}`}>{k}</button>)}
				</div>
				<Text size="sm" tone="muted">
					<span id="tui-help">Ticks change this page’s copy of the plans, nothing on disk. The dates are pinned to 1 October 2026, like the screens above.</span>
				</Text>
			</Stack>
			<dl class="keys">
				{keys.map(([k, what]) => (
					<div><dt><kbd>{k}</kbd></dt><dd>{what}</dd></div>
				))}
			</dl>
		</div>
	</Section>

	<Section id="pipes-h" title="Pipes, not plugins." intro="Plain output and meaningful exit codes let Sprig work with the tools already on the machine, so it needs no plugin system.">
		<Grid cols={2} gap={6} rowGap={6}>
			{
				recipes.map(([title, body, cmd]) => (
					<Stack gap={3}>
						<Stack gap={1}>
							<Text as="h3" size="md" weight="bold">{title}</Text>
							<Text size="sm" tone="muted">{body}</Text>
						</Stack>
						<Terminal command={cmd} />
					</Stack>
				))
			}
		</Grid>
		<Inline gap={4}>
			<a class="text-link" href={url('/roadmap/')}>Where each command lands</a>
			<a class="text-link" href={`${repo}/blob/main/design/cli-plan.html`}>The full CLI plan</a>
		</Inline>
	</Section>

	<script type="application/json" id="tui-files" set:html={JSON.stringify(files)} />
	<script>
		import '../scripts/tui.js';
	</script>
</Base>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		gap: var(--space-8);
		align-items: center;
		padding-block: var(--space-10) var(--space-6);
	}
	.narrow {
		max-width: var(--measure-prose);
	}
	.cmds {
		margin: 0;
	}
	.cmd {
		padding-block: var(--space-3);
		border-top: 1px solid var(--border);
	}
	.cmd dt {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-3);
	}
	.cmd code {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		font-weight: var(--weight-bold);
	}
	.when {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--text-muted);
		white-space: nowrap;
	}
	.cmd dd {
		margin: var(--space-1) 0 0;
		font-size: var(--text-sm);
		color: var(--text-muted);
	}
	.table {
		overflow-x: auto;
	}
	table {
		border-collapse: collapse;
		width: 100%;
		font-size: var(--text-sm);
	}
	th,
	td {
		text-align: left;
		vertical-align: top;
		padding: var(--space-3) var(--space-4) var(--space-3) 0;
		border-bottom: 1px solid var(--border);
	}
	th {
		font-size: var(--text-xs);
		font-weight: var(--weight-medium);
		color: var(--text-muted);
	}
	td code {
		font-family: var(--font-mono);
		white-space: nowrap;
	}
	.tui-wrap {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 220px;
		gap: var(--space-7);
		align-items: start;
	}
	.strip {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
	.strip button {
		min-width: 40px;
		min-height: 36px;
		padding: 0 var(--space-3);
		font: inherit;
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		color: var(--text);
		background: none;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-md);
		cursor: pointer;
	}
	.strip button:hover {
		background: var(--surface-raised);
	}
	.strip button:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}
	.keys {
		margin: 0;
	}
	.keys div {
		display: grid;
		grid-template-columns: 64px minmax(0, 1fr);
		gap: var(--space-3);
		padding-block: var(--space-2);
		border-top: 1px solid var(--border);
		font-size: var(--text-sm);
	}
	.keys dd {
		margin: 0;
		color: var(--text-muted);
	}
	kbd {
		font-family: var(--font-mono);
		font-weight: var(--weight-bold);
	}
	.text-link {
		color: var(--text);
		font-size: var(--text-sm);
	}
	@media (max-width: 859px) {
		.hero,
		.tui-wrap {
			grid-template-columns: minmax(0, 1fr);
		}
		.hero {
			padding-block: var(--space-8) var(--space-4);
			gap: var(--space-6);
		}
	}
</style>
