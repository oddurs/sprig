# Build output
/target

# Worktrees created by scripts/agent live beside the repository, but a stray
# one inside it must never be committed.
.worktrees/

# Editors
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store

# The website: dependencies, build output, and content generated from the
# repository at build time by site/scripts/sync.mjs
/site/node_modules/
/site/dist/
/site/.astro/
/site/src/generated/
/site/public/spec.md
/site/public/spec-annex.md
/site/src/content/docs/spec.md
/site/src/content/docs/decisions.md
/site/src/content/docs/roadmap.md
/site/src/content/docs/changelog.md
/site/src/content/docs/docs/reference/cli.md
/site/src/content/docs/docs/reference/mcp.md
/site/src/content/docs/docs/reference/diagnostics.md
/editors/node_modules/
/editors/vscode/node_modules/
/tests/mcp/node_modules/
/editors/vscode/.vscode-test/
# Copied in by editors/vscode/scripts/prepare.js
/editors/vscode/syntaxes/
/editors/vscode/server/
/editors/vscode/LICENSE
*.vsix

# Fuzzing: generated inputs and the fuzzer's own build.
/crates/sprig-core/fuzz/corpus/
/crates/sprig-core/fuzz/artifacts/
/crates/sprig-core/fuzz/target/
/crates/sprig-core/fuzz/coverage/

# Downloads and build outputs, so `git add -A` cannot sweep one in;
# `scripts/task lint` refuses any that are committed anyway (cairn 0151).
*.tar
*.tar.*
*.tgz
*.zip
*.whl
*.crate
